# Written by HomersLab's agent. Never edit by hand.
# Storage location music: a network share on the mesh, mounted by the standard mount command (ADR 0014). The firewall
# table lets this machine reach its server through the mesh only, never the LAN.
[Unit]
Description=HomersLab storage location music
Documentation=https://github.com/ArjunRachithcf/homerslab
After=network-online.target netbird.service homerslab-agent.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
StateDirectory=homerslab-storage/music
StateDirectoryMode=0700
ExecStart=/usr/bin/mount -t nfs -o nosuid,nodev,noexec 100.64.1.3:/volume1/Music /var/lib/homerslab-storage/music
# Lazily: a share whose server is gone never holds up a shutdown.
ExecStop=/usr/bin/umount -l /var/lib/homerslab-storage/music
TimeoutStartSec=60s
# Until the mesh is up at boot, or the share answers again.
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
