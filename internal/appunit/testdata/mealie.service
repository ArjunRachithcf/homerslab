# Written by HomersLab's agent, from install plan p-3a5f8e0c1d2b4a6978c0e1f2a3b4c5d6. Never edit by hand.
# App mealie, run by the standard compose command on its catalog's compose file and the agent's (ADR 0014).
# systemd owns the containers: their restart policies are off, and this unit restarts them; a container that stops
# ends the compose command, which stops the others. The app's secrets are credentials the agent sealed (ADR 0011),
# copied into the runtime directory for the one container user that reads each, at the app's own SELinux level.
# No mount sandboxing: Docker's daemon must see that directory.
[Unit]
Description=HomersLab app mealie
Documentation=https://github.com/ArjunRachithcf/homerslab
Requires=docker.service
After=docker.service network-online.target homerslab-agent.service
Wants=network-online.target

[Service]
Type=exec
RuntimeDirectory=homerslab-app-mealie
RuntimeDirectoryMode=0700
UMask=0077
LoadCredentialEncrypted=mealie.oidc-client-secret:/var/lib/homerslab-agent/apps/mealie/credentials/oidc-client-secret.cred
ExecStartPre=/usr/bin/install -m 0400 -o 911 -g 911 %d/mealie.oidc-client-secret /run/homerslab-app-mealie/oidc-client-secret
ExecStartPre=/usr/bin/chcon -t container_file_t -l s0:c604,c605 /run/homerslab-app-mealie/oidc-client-secret
ExecStart=/usr/bin/docker compose --project-name homerslab-mealie --project-directory /var/lib/homerslab-agent/apps/mealie --file /var/lib/homerslab-agent/apps/mealie/compose.yaml --file /var/lib/homerslab-agent/apps/mealie/homerslab.yaml up --no-log-prefix --quiet-pull --abort-on-container-exit
# Not into the journal: compose writes the containers' output there, secrets and all; the agent reads the app's
# logs from the engine, its secrets cut out. systemd still logs the unit's starts, stops and exit statuses.
StandardOutput=null
StandardError=null
ExecStopPost=/usr/bin/docker compose --project-name homerslab-mealie --project-directory /var/lib/homerslab-agent/apps/mealie --file /var/lib/homerslab-agent/apps/mealie/compose.yaml --file /var/lib/homerslab-agent/apps/mealie/homerslab.yaml stop
# Always: compose ends with the stopped container's own exit status, 0 included.
Restart=always
# systemctl stop: compose ends with 130 when it stops the containers itself.
SuccessExitStatus=130
RestartSec=10s
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target
