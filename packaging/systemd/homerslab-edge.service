# The node's edge: Caddy, as its own unprivileged user, with only the capability to bind low ports (ADR 0006). It
# starts with no site: the agent configures it through its admin API alone, on a socket only the edge's user and the
# agent may open, and pushes the whole configuration again whenever it starts (autosave is off). Its certificates are
# systemd credentials the agent sealed, loaded as files through a drop-in the agent writes: no private key is ever in
# its configuration, its admin API or its storage (#78).
[Unit]
Description=HomersLab edge
Documentation=https://github.com/ArjunRachithcf/homerslab
Wants=network-online.target
After=network-online.target homerslab-agent.service

[Service]
Type=notify
User=homerslab-edge
Group=homerslab-edge
# Caddy 2.11.2 or later. --config, never --resume: the agent is the source of truth.
ExecStart=/usr/bin/caddy run --config /usr/share/homerslab/edge-boot.json
Environment=HOME=/var/lib/homerslab-edge XDG_DATA_HOME=/var/lib/homerslab-edge XDG_CONFIG_HOME=/var/lib/homerslab-edge
# The admin socket's directory: the edge's user, and its group, which only the agent is in (SupplementaryGroups in
# homerslab-agent.service). Nobody else can enter it.
RuntimeDirectory=homerslab-edge
RuntimeDirectoryMode=0750
StateDirectory=homerslab-edge
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
