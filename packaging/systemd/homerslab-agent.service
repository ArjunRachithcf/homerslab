# The agent owns this node's host, so it runs as root. Its API is a Unix socket for root and the manager's group.
[Unit]
Description=HomersLab agent
Documentation=https://github.com/ArjunRachithcf/homerslab
Before=homerslab-manager.service

[Service]
Type=exec
ExecStart=/usr/bin/homerslab agent
RuntimeDirectory=homerslab-agent
RuntimeDirectoryMode=0755
UMask=0077
Restart=on-failure
RestartSec=2s

# So far the agent reads the machine's facts (/etc, /proc, /sys, pci.ids, the space under /var/lib/homerslab), reads
# apps' compose files for planning, and answers on its socket, which it hands to the manager's group (CAP_CHOWN).
# Each compose read runs in a child of its own (homerslab agent read-project), in an empty folder of its private /tmp
# that the agent gives to nobody (CAP_CHOWN); the child starts as nobody, its IDs set in the fork (CAP_SETUID,
# CAP_SETGID). Later tickets loosen this as its contract grows: the firewall (netlink, CAP_NET_ADMIN), the engine, app
# units, disks. Checked as a transient user unit with these settings (Fedora 44):
# the facts, TPM and GPUs included, read in full. To check again as root at the first package install (#48).
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Its compose reads run as nobody, one at a time, each killed at its deadline and limited on its own; the unit, with
# those children, gets at most one core and 512 MB, far above what it uses (tens of MB).
MemoryMax=512M
CPUQuota=100%
# A child the kernel kills for memory (each asks to be first: oom_score_adj 1000) ends that read, not the agent.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
