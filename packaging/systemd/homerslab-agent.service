# The agent owns this node's host, so it runs as root. Its API is a Unix socket for root and the manager's group.
[Unit]
Description=HomersLab agent
Documentation=https://github.com/ArjunRachithcf/homerslab
# The table is loaded at boot by homerslab-firewall-restore, before the network and the engines; the agent takes it
# over after that, and orders itself against nothing of the engines' or the network's: it never waits on them, and
# they never wait on it.
Wants=homerslab-firewall-restore.service
After=homerslab-firewall-restore.service
Before=homerslab-manager.service

[Service]
# Ready once the agent has applied its table (from its saved state: it asks no engine first) and its socket listens.
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
# systemd-creds' host key, made once, outside the sandbox (which keeps /var/lib/systemd read-only).
ExecStartPre=+/usr/bin/systemd-creds setup
ExecStart=/usr/bin/homerslab agent
# The edge's group: the agent alone opens the edge's admin socket.
SupplementaryGroups=homerslab-edge
RuntimeDirectory=homerslab-agent
RuntimeDirectoryMode=0755
# The agent's state (agent.json: the firewall table's settings) and the manager's sealed credentials.
StateDirectory=homerslab-agent
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s

# The agent reads the machine's facts (/etc, /proc, /sys, pci.ids, the space under /var/lib/homerslab) and answers on
# its socket, which it hands to the manager's group (CAP_CHOWN). Since #15 it also:
#   - owns the firewall table, inet homerslab, in the host's own network (nft over netlink, CAP_NET_ADMIN);
#   - joins the mesh: a drop-in for NetBird's service (NAT mapper off), systemctl, netbird up, and a check that the
#     machine's resolver still answers (AF_INET, AF_INET6);
#   - seals the manager's credentials with systemd-creds, in its state directory, with the TPM where there is one;
#   - since #16, seals the edge's certificates, writes the edge's drop-in, restarts the edge (systemctl) and configures
#     it through its admin socket (the edge's group).
# Every file it reads is world-readable or its own, so it reads no one else's files and no home (#71): no
# CAP_DAC_READ_SEARCH, ProtectHome=yes. Its devices are closed but for the TPM's resource manager, which sealing uses
# (ADR 0011), so not PrivateDevices, which would hide it.
# Since #18 it reads apps' compose files for planning, each in a child of its own (homerslab agent read-project), in
# an empty folder of its private /tmp that the agent gives to nobody (CAP_CHOWN); the child starts as nobody, its IDs
# set in the fork (CAP_SETUID, CAP_SETGID). Without CAP_KILL the agent can't signal it, nor send it the parent-death
# signal, so the child ends itself (#138): at the deadline it was handed, and when its control pipe closes, as it does
# when the agent dies. CI runs those tests as root with exactly this unit's CapabilityBoundingSet (as-unit.sh).
# Later tickets loosen this as its contract grows: the engine, app units, disks. To check as root at the first package
# install (#48).
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_NET_ADMIN CAP_SETUID CAP_SETGID
ProtectSystem=strict
# NetBird's and the edge's drop-ins only (agent.RootWrites; the folders come from tmpfiles.d/homerslab.conf).
ReadWritePaths=/etc/systemd/system/netbird.service.d /etc/systemd/system/homerslab-edge.service.d
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
PrivateIPC=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
PrivateNetwork=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Its compose reads run as nobody, one at a time, each ended at its deadline and limited on its own; the unit, with
# those children, gets at most one core and 512 MB, far above what it uses (tens of MB).
MemoryMax=512M
CPUQuota=100%
# A child the kernel kills for memory (each asks to be first: oom_score_adj 1000) ends that read, not the agent.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
