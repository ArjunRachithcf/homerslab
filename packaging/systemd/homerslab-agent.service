# The agent owns this node's host, so it runs as root. Its API is a Unix socket for root and the manager's group.
[Unit]
Description=HomersLab agent
Documentation=https://github.com/ArjunRachithcf/homerslab
# The firewall table is up before the network, the engines and the mesh client: no LAN host meets a published port
# or a listener while the machine boots.
Wants=network-pre.target
Before=homerslab-manager.service network-pre.target docker.service podman.service netbird.service

[Service]
# Ready once the firewall table is restored and the socket listens.
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/homerslab agent
RuntimeDirectory=homerslab-agent
RuntimeDirectoryMode=0755
# The agent's state (agent.json: the firewall table's settings) and the manager's sealed credentials.
StateDirectory=homerslab-agent
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s

# The agent reads the machine's facts (/etc, /proc, /sys, pci.ids) and answers on its socket, which it hands to the
# manager's group (CAP_CHOWN). Since #15 it also:
#   - owns the firewall table, inet homerslab, in the host's own network (nft over netlink, CAP_NET_ADMIN);
#   - joins the mesh: a drop-in for NetBird's service (NAT mapper off), systemctl, netbird up, and a check that the
#     machine's resolver still answers (AF_INET, AF_INET6);
#   - seals the manager's credentials with systemd-creds, in its state directory.
# Later tickets loosen this as its contract grows: the engine, app units, disks. To check as root at the first package
# install (#48).
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH CAP_NET_ADMIN
ProtectSystem=strict
# NetBird's drop-in, and systemd-creds' host key (/var/lib/systemd/credential.secret), made on first use.
ReadWritePaths=/etc/systemd/system /var/lib/systemd
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
